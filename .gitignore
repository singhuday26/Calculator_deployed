# ===========================================================================
# .GITIGNORE — Files Git Should Not Track
# ===========================================================================
# 
# WHY THIS FILE MATTERS:
# Without .gitignore, you'd accidentally commit node_modules/ (500MB+),
# build outputs, environment secrets, and OS junk files to your repo.
# That bloats the repo, leaks secrets, and causes merge conflicts.
#
# RULE OF THUMB: Don't commit anything that can be:
# 1. Regenerated (node_modules, dist, build artifacts)
# 2. Personal (IDE settings, OS files)
# 3. Secret (API keys, .env files)
# ===========================================================================

# ── Dependencies ──────────────────────────────────────────────
# node_modules/ contains ALL npm packages (often 500MB+).
# It's regenerated by `npm install` from package.json + package-lock.json.
node_modules/

# ── Build Output ──────────────────────────────────────────────
# The dist/ folder is generated by `npm run build`.
# Never edit files in dist/ — they're auto-generated.
dist/
dist-ssr/

# ── Environment Variables ─────────────────────────────────────
# .env files often contain API keys and secrets.
# NEVER commit these. Share them securely (1Password, Vault, etc.)
.env
.env.local
.env.*.local

# ── IDE & Editor ──────────────────────────────────────────────
# Each developer has their own IDE settings.
# Exception: .vscode/launch.json and tasks.json ARE often committed
# when the entire team uses VS Code.
.idea/
*.swp
*.swo
*~

# ── Operating System ──────────────────────────────────────────
# macOS creates .DS_Store in every directory you browse.
# Windows creates Thumbs.db for image thumbnails.
.DS_Store
Thumbs.db

# ── TypeScript ────────────────────────────────────────────────
# tsbuildinfo is a cache file for faster incremental builds.
*.tsbuildinfo

# ── Testing ───────────────────────────────────────────────────
coverage/

# ── Capacitor / Android ──────────────────────────────────────
# Capacitor recommends COMMITTING android/ and ios/ folders for production apps.
# This allows CI/CD to build directly and tracks native configuration changes.
# We only ignore build artifacts and local files:

# Android build artifacts
android/app/build/
android/app/release/
android/build/
android/.gradle/
android/local.properties
android/.idea/
android/*.iml

# iOS build artifacts (when ios/ is added)
ios/App/Pods/
ios/App/build/
ios/App/*.xcworkspace/xcuserdata/

# ── PWA ───────────────────────────────────────────────────────
# Service worker files are auto-generated during build.
dev-dist/
